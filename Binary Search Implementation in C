#include <stdio.h>

int main()
{
    int arr[] = {5, 10, 15, 20, 25, 30};
    int size = sizeof(arr) / sizeof(arr[0]);
    int low = 0;
    int high = size - 1;
    int mid;
    int target = 25;
    int found = 0;

    // Binary Search loop
    // Loop continues while search space is valid
    while (low <= high)
    {
        // Calculate middle index
        mid = (low + high) / 2;

        // Check if target is found
        if (arr[mid] == target)
        {
            printf("Target element is at index %d", mid);
            found = 1;
            break;
        }
        // If target is greater, ignore left half
        else if (arr[mid] < target)
        {
            low = mid + 1;
        }
        // If target is smaller, ignore right half
        else
        {
            high = mid - 1;
        }
    }

    // If target is not found in the array
    if (found == 0)
    {
        printf("Target element is not found");
    }

    return 0;
}
